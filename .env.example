# Optional cloud features. Do not put these in VITE_* variables or frontend files.
# Set in Vercel Project Settings > Environment Variables, then redeploy.
GOOGLE_API_KEY=
# Choose a currently available Gemini model supporting PDF/image input + structured JSON.
# Availability depends on your account and region. No model is downloaded at startup.
GEMINI_MODEL=

# Required for cloud features on Vercel. Recommended before any public launch.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
RATE_LIMIT_SALT=
CLOUD_DAILY_REQUEST_LIMIT=100
